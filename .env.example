# Kopieren nach .env und anpassen. .env wird nie eingecheckt.

# Zufälliger, langer String – signiert die Admin-Session-Cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Pfade (relativ zu backend/, oder absolut)
DATABASE_PATH=./buschfunk.db
MEDIA_DIR=../media

# Icecast-Zugangsdaten für den ffmpeg-Source-Stream
# (8001, NICHT 8000 - das belegt bereits BuschFunk selbst, siehe run.py/PORT)
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8001
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_MOUNT=/stream

# Cloudflare Named Tunnel Token (nur nötig, wenn cloudflared als Sidecar läuft;
# siehe deploy/cloudflared/config.yml.example)
CLOUDFLARE_TUNNEL_TOKEN=

# Audio-Backend: "auto" erkennt PipeWire automatisch, sonst "dummy" erzwingen
AUDIO_BACKEND=auto
